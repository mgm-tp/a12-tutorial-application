  <bpmn:process id="CustomerOnboardingProcess" name="Customer Onboarding" isExecutable="true" camunda:versionTag="1" camunda:historyTimeToLive="999999">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_0sn7th8</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0sn7th8" sourceRef="StartEvent_1" targetRef="Activity_1ic4ymo" />
    <bpmn:userTask id="Activity_1ic4ymo" name="Create contact" camunda:formKey="OnboardCustomer_FM">
      <bpmn:incoming>Flow_0sn7th8</bpmn:incoming>
      <bpmn:outgoing>Flow_1ggzop4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_1ia03ne" name="VIP?" default="Flow_1a4mrm0">
      <bpmn:incoming>Flow_13z6wmc</bpmn:incoming>
      <bpmn:outgoing>Flow_1imu1nv</bpmn:outgoing>
      <bpmn:outgoing>Flow_1a4mrm0</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1ggzop4" sourceRef="Activity_1ic4ymo" targetRef="assignSalesRepActivity" />
    <bpmn:sequenceFlow id="Flow_1imu1nv" name="yes" sourceRef="Gateway_1ia03ne" targetRef="generateGiftCardActivity">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${customerType == "vip"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="generateGiftCardActivity" name="Generate new gift card" camunda:asyncAfter="true" camunda:type="external" camunda:topic="GENERATE_GIFT_CARD">
      <bpmn:incoming>Flow_1imu1nv</bpmn:incoming>
      <bpmn:outgoing>Flow_1qwci2a</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_142s6gq">
      <bpmn:incoming>Flow_1a4mrm0</bpmn:incoming>
      <bpmn:incoming>Flow_11cuv22</bpmn:incoming>
      <bpmn:outgoing>Flow_1y46qfc</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1qwci2a" sourceRef="generateGiftCardActivity" targetRef="sendWelcomeGiftCardActivity" />
    <bpmn:sequenceFlow id="Flow_1a4mrm0" name="no" sourceRef="Gateway_1ia03ne" targetRef="Gateway_142s6gq" />
    <bpmn:sequenceFlow id="Flow_13z6wmc" sourceRef="assignSalesRepActivity" targetRef="Gateway_1ia03ne" />
    <bpmn:sequenceFlow id="Flow_11cuv22" sourceRef="sendWelcomeGiftCardActivity" targetRef="Gateway_142s6gq" />
    <bpmn:serviceTask id="sendWelcomeGiftCardActivity" name="Send welcome gift card" camunda:delegateExpression="${sendGiftCardDelegate}">
      <bpmn:incoming>Flow_1qwci2a</bpmn:incoming>
      <bpmn:outgoing>Flow_11cuv22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1y46qfc" sourceRef="Gateway_142s6gq" targetRef="Event_0bg3sao" />
    <bpmn:scriptTask id="assignSalesRepActivity" name="Assign sales rep" scriptFormat="js" camunda:resource="scripts/assignSalesRep.js">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="customerType">${customerType}</camunda:inputParameter>
          <camunda:outputParameter name="salesRep">${salesRep}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1ggzop4</bpmn:incoming>
      <bpmn:outgoing>Flow_13z6wmc</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="Event_0bg3sao" name="">
      <bpmn:incoming>Flow_1y46qfc</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:textAnnotation id="TextAnnotation_1clv2n2">
      <bpmn:text>Worker</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0smcevk" associationDirection="None" sourceRef="generateGiftCardActivity" targetRef="TextAnnotation_1clv2n2" />
    <bpmn:textAnnotation id="TextAnnotation_1agz2cb">
      <bpmn:text>Delegate</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0s0r429" associationDirection="None" sourceRef="sendWelcomeGiftCardActivity" targetRef="TextAnnotation_1agz2cb" />
    <bpmn:textAnnotation id="TextAnnotation_18ozqg4">
      <bpmn:text>JS Script</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_06r6ojz" associationDirection="None" sourceRef="assignSalesRepActivity" targetRef="TextAnnotation_18ozqg4" />
  </bpmn:process>
