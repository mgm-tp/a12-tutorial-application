          "type": "http",
          "name": "Constraint Properties",
          "seq": 4,
          "request": {
            "url": "http://localhost:8081/api/v2/rpc",
            "method": "POST",
            "headers": [
              {
                "name": "Authorization",
                "value": "UAABEARER {{Authorization}}",
                "enabled": true
              }
            ],
            "params": [],
            "body": {
              "mode": "json",
              "json": "{\n  \"id\": \"Constraint Properties\",\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"QUERY\",\n  \"params\": {\n    \"query\": {\n      \"targetDocumentModel\": \"Contact_DM\",\n      \"projectionName\": \"document\",\n      \"constraint\": {\n        \"operator\": \"and\",\n        \"operands\": [\n          {\n            \"operator\": \"exact_match\",\n            \"field\": \"/Contact/PersonalData/Nationality\",\n            \"value\": \"German\"\n          },\n          {\n            \"operator\": \"exact_match\",\n            \"field\": \"/Contact/PersonalData/LastName\",\n            \"value\": \"Baker\"\n          },\n          {\n            \"operator\": \"not\",\n            \"operand\": {\n              \"operator\": \"exact_match\",\n              \"field\": \"/Contact/PersonalData/Gender\",\n              \"value\": \"MALE\"\n            }\n          }\n        ]\n      },\n      \"paging\": {\n        \"pageSize\": 10,\n        \"pageNumber\": 0\n      }\n    }\n  }\n}",
              "formUrlEncoded": [],
              "multipartForm": []
            },
            "script": {},
            "vars": {},
            "assertions": [],
            "tests": "",
            "docs": "",
            "auth": {
              "mode": "none"
            }
