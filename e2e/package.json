{
  "name": "@com.mgmtp.your-project-name/e2e",
  "description": "End to end test for Your-Project-Name",
  "author": "mgm technology partners",
  "license": "(EUPL-1.2 OR LicenseRef-commercial)",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf node_modules .auth test-results playwright-report",
    "e2e:install": "playwright install chromium",
    "e2e:test": "playwright test --project=base",
    "e2e:test-extended": "playwright test --project=base --project=extended",
    "e2e:test-ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "lint": "eslint .",
    "format": "prettier --check \"./*.js\" \"**/*.{ts,tsx}\"",
    "format:fix": "prettier --write \"./*.js\" \"**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.13.0",
    "moment-timezone": "^0.6.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.0",
    "typescript": "^6.0.3"
  }
}
