  "scripts": {
    "clean": "rimraf build node_modules",
    "generate": "node scripts/auto-discover.js",
    "start": "npm run webpack-dev-server",
    "compile": "npm run generate && npm-run-all --aggregate-output --continue-on-error --parallel compile:**",
    "compile:typescript": "tsc",
    "compile:lint": "npm run lint",
    "compile:format": "npm run format",
    "skip:lint-format-compile": "npm run generate && npm-run-all --aggregate-output --continue-on-error --parallel compile:typescript",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "webpack": "npm run generate && cross-env process.env.NODE_ENV=production webpack --config webpack.prod.js",
    "webpack-dev-server": "npm run generate && webpack-dev-server --config webpack.dev.js",
    "format": "prettier --check \"./*.js\" \"src/**/*.{ts,tsx}\"",
    "format:fix": "prettier --write \"./*.js\" \"src/**/*.{ts,tsx}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run src/tests/components/ --coverage"
  },
